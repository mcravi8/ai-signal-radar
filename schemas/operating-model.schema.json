{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-signal-radar/operating-model.schema.json",
  "title": "AI Signal Radar startup operating model",
  "type": "object",
  "required": ["meta", "purpose", "maturity_order", "maturity_definitions", "dimension_rules", "relationship_types", "guardrails", "requirements", "boundary"],
  "properties": {
    "meta": {"type": "object", "required": ["title", "generated_at", "as_of", "policy_version", "requirement_count", "maturity_counts"]},
    "purpose": {"type": "string", "minLength": 1},
    "maturity_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "maturity_definitions": {"type": "object"},
    "dimension_rules": {"type": "object"},
    "relationship_types": {"type": "object"},
    "guardrails": {"type": "array", "items": {"type": "object", "required": ["id", "rule"]}},
    "requirements": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "title", "maturity", "description", "evidence"]}
    },
    "boundary": {"type": "string", "minLength": 1}
  }
}
